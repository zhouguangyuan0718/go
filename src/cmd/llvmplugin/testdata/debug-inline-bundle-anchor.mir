# CHECK-LABEL: name: main.bundleAnchor
# CHECK:       NOP pre-instr-symbol
# CHECK-NEXT:  BUNDLE implicit-def $x8
# CHECK-NEXT:    $x8 = ADRP target-flags(aarch64-page) @main.bundleGlobal
# CHECK-NEXT:    $x8 = ADDXri internal $x8,

--- |
  target triple = "aarch64-unknown-linux-goobj"

  @main.bundleGlobal = external global i64

  define goabiinternal void @main.bundleAnchor() !dbg !10 {
    ret void
  }

  !llvm.dbg.cu = !{!0}
  !llvm.module.flags = !{!5, !6}
  !0 = distinct !DICompileUnit(language: DW_LANG_Go, file: !1, producer: "goallc-test", isOptimized: true, runtimeVersion: 0, emissionKind: LineTablesOnly, enums: !2, splitDebugInlining: true, nameTableKind: None)
  !1 = !DIFile(filename: "bundle.go", directory: "/tmp/goobj-inline")
  !2 = !{}
  !3 = !DISubroutineType(types: !2)
  !5 = !{i32 7, !"Dwarf Version", i32 4}
  !6 = !{i32 2, !"Debug Info Version", i32 3}
  !10 = distinct !DISubprogram(name: "main.bundleAnchor", linkageName: "main.bundleAnchor", scope: !1, file: !1, line: 1, type: !3, scopeLine: 1, spFlags: DISPFlagDefinition | DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !11 = distinct !DISubprogram(name: "main.bundleChild", linkageName: "main.bundleChild", scope: !1, file: !1, line: 10, type: !3, scopeLine: 10, spFlags: DISPFlagOptimized, unit: !0, retainedNodes: !2)
  !12 = distinct !DILocation(line: 2, column: 1, scope: !10)
  !13 = !DILocation(line: 11, column: 1, scope: !11, inlinedAt: !12)
  !14 = !DILocation(line: 3, column: 1, scope: !10)
...
---
name:            main.bundleAnchor
tracksRegLiveness: true
body:             |
  bb.0:
    BUNDLE implicit-def $x8, debug-location !14 {
      $x8 = ADRP target-flags(aarch64-page) @main.bundleGlobal, debug-location !13
      $x8 = ADDXri internal $x8, target-flags(aarch64-pageoff, aarch64-nc) @main.bundleGlobal, 0, debug-location !13
    }
    RET_ReallyLR debug-location !14
...
